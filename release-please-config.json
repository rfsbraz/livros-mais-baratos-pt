{
  "packages": {
    ".": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "manifest.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Funcionalidades"
        },
        {
          "type": "fix",
          "section": "Corre\u00e7\u00f5es"
        },
        {
          "type": "perf",
          "section": "Desempenho"
        },
        {
          "type": "deps",
          "section": "Depend\u00eancias"
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "refactor",
          "hidden": true
        }
      ],
      "pull-request-title-pattern": "chore${scope}: publicar${component} ${version}",
      "pull-request-header": "- Prepara\u00e7\u00e3o de uma nova vers\u00e3o. Rev\u00ea e traduz para portugu\u00eas de Portugal as notas extra\u00eddas de commits em ingl\u00eas antes de integrar.",
      "pull-request-footer": ""
    }
  }
}
