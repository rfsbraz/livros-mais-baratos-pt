{
  "packages": {
    ".": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "manifest.json",
          "jsonpath": "$.version"
        },
        "version.txt"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Funcionalidades"
        },
        {
          "type": "fix",
          "section": "Correções"
        },
        {
          "type": "perf",
          "section": "Desempenho"
        },
        {
          "type": "deps",
          "section": "Dependências"
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "refactor",
          "hidden": true
        }
      ],
      "pull-request-title-pattern": "chore${scope}: publicar${component} ${version}",
      "pull-request-header": "- Preparação de uma nova versão. Revê e traduz para português de Portugal as notas extraídas de commits em inglês antes de integrar.",
      "pull-request-footer": ""
    }
  }
}
