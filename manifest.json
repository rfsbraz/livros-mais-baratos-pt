{
  "manifest_version": 3,
  "name": "Livros Mais Baratos PT",
  "version": "0.1.6",
  "description": "Compara preços de livros em Portugal, recebe alertas de preço-alvo e consulta o histórico das tuas pesquisas.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "alarms", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comparar preços de livros",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "parser.js",
        "core.js",
        "stores.js",
        "auto-rules.js",
        "affiliate.js",
        "promotions.js",
        "promotion-view.js"
      ],
      "matches": [
        "https://www.wook.pt/*",
        "https://www.bertrand.pt/*",
        "https://www.almedina.net/*",
        "https://bookcover.pt/*",
        "https://www.continente.pt/*",
        "https://www.portoeditora.pt/*",
        "https://www.lyvros.com/*",
        "https://penguinlivros.pt/*",
        "https://www.presenca.pt/*",
        "https://www.guerraepaz.pt/*",
        "https://www.gradiva.pt/*",
        "https://www.relogiodagua.pt/*",
        "https://www.saidadeemergencia.com/*",
        "https://www.quetzaleditores.pt/*",
        "https://antigona.pt/*",
        "https://www.livrariasnob.pt/*",
        "https://kingpinbooks.com/*",
        "https://mbooks.pt/*",
        "https://www.auchan.pt/*",
        "https://blackwells.co.uk/*",
        "https://www.waterstones.com/*",
        "https://www.iberlibro.com/*",
        "https://www.abebooks.com/*",
        "https://www.elcorteingles.pt/*",
        "https://mundofantasma.com/*",
        "https://editoradevir.pt/*"
      ]
    }
  ],
  "host_permissions": [
    "https://www.wook.pt/*",
    "https://www.bertrand.pt/*",
    "https://www.almedina.net/*",
    "https://bookcover.pt/*",
    "https://www.continente.pt/*",
    "https://www.portoeditora.pt/*",
    "https://www.lyvros.com/*",
    "https://penguinlivros.pt/*",
    "https://www.presenca.pt/*",
    "https://www.guerraepaz.pt/*",
    "https://www.gradiva.pt/*",
    "https://www.relogiodagua.pt/*",
    "https://www.saidadeemergencia.com/*",
    "https://www.quetzaleditores.pt/*",
    "https://antigona.pt/*",
    "https://www.livrariasnob.pt/*",
    "https://kingpinbooks.com/*",
    "https://mbooks.pt/*",
    "https://www.auchan.pt/*",
    "https://blackwells.co.uk/*",
    "https://www.waterstones.com/*",
    "https://www.iberlibro.com/*",
    "https://www.abebooks.com/*",
    "https://www.elcorteingles.pt/*",
    "https://mundofantasma.com/*",
    "https://editoradevir.pt/*"
  ]
}
